module(name = "quickshare_linux_app", version = "0.0.0")

bazel_dep(name = "rules_cc", version = "0.2.17")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# TODO: switch to the published GitHub Release URL once the v0.1.0 release
# finishes publishing (https://github.com/ostrichbat2k/nearby/releases/tag/v0.1.0).
http_archive(
    name = "nearby_linux_platform",
    url = "file:///home/jayaprakash/claude/quickshare-linux/release/linux/dist/nearby-linux-platform-v0.1.0.tar.gz",
    sha256 = "bd853290099a71fc2beb64ce4dbef4c09b43fa9f9f82f89eec16866a2b6f9373",
    build_file_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "linux_platform",
    srcs = ["lib/libnearby_linux.a"],
    hdrs = glob(["include/**/*.h", "include/**/*.inc"]),
    includes = ["include"],
    linkopts = [
        "-lsdbus-c++",
        "-lsystemd",
        "-lpthread",
    ],
    visibility = ["//visibility:public"],
)
""",
)
